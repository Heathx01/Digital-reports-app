<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================================= -->
<!-- DocuField Industrial - Tokens Tipográficos y Estilos (Android XML)-->
<!-- Ubicación recomendada: res/values/typography.xml                  -->
<!-- ================================================================= -->
<resources>
    <!-- Dimensiones Tipográficas en SP -->
    <dimen name="text_display_large">32sp</dimen>
    <dimen name="text_headline_medium">24sp</dimen>
    <dimen name="text_title_large">20sp</dimen>
    <dimen name="text_title_medium">16sp</dimen>
    <dimen name="text_title_small">14sp</dimen>
    <dimen name="text_body_large">16sp</dimen>
    <dimen name="text_body_medium">14sp</dimen>
    <dimen name="text_body_small">12sp</dimen>
    <dimen name="text_label_large">14sp</dimen>
    <dimen name="text_label_medium">12sp</dimen>
    <dimen name="text_label_small">10sp</dimen>

    <!-- Radios de Esquinas Liquid Glass en DP -->
    <dimen name="glass_radius_xs">4dp</dimen>
    <dimen name="glass_radius_sm">8dp</dimen>
    <dimen name="glass_radius_md">12dp</dimen>
    <dimen name="glass_radius_lg">16dp</dimen>
    <dimen name="glass_radius_xl">20dp</dimen>
    <dimen name="glass_radius_pill">9999dp</dimen>

    <!-- Espaciados y Desenfocados (Blur) en DP -->
    <dimen name="glass_blur_subtle">12dp</dimen>
    <dimen name="glass_blur_standard">16dp</dimen>
    <dimen name="glass_blur_prominent">24dp</dimen>
    <dimen name="glass_border_width">1dp</dimen>

    <!-- Base Parent Style -->
    <style name="TextAppearance.DocuField" parent="@android:style/TextAppearance" />

    <!-- Estilos Tipográficos según escala Material 3 -->
    <style name="TextAppearance.DocuField.DisplayLarge" parent="@android:style/TextAppearance.Large">
        <item name="android:textSize">@dimen/text_display_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.DocuField.HeadlineMedium" parent="@android:style/TextAppearance.Large">
        <item name="android:textSize">@dimen/text_headline_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.DocuField.TitleLarge" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">@dimen/text_title_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="TextAppearance.DocuField.TitleMedium" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">@dimen/text_title_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.DocuField.BodyMedium" parent="@android:style/TextAppearance.Small">
        <item name="android:textSize">@dimen/text_body_medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.DocuField.TelemetryMono">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:typeface">monospace</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
</resources>
